# NEUROCORE Environment Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Ollama Local AI Integration (uses local machine models)
OLLAMA_ENDPOINT=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:3b-instruct
OLLAMA_DEFAULT_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_TIMEOUT_SECONDS=60

# Simulation Configuration
DEFAULT_NUM_NEURONS=1000
DEFAULT_DT_MS=0.1
DEFAULT_EXCITATORY_RATIO=0.8
RANDOM_SEED=42
